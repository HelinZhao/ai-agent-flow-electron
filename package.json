{
  "name": "ai-agent-flow-electron",
  "version": "1.7.0",
  "type": "module",
  "description": "An Electron application with React and TypeScript",
  "license": "Anti-Commercial",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "node scripts/prepare-env.mjs && electron-vite preview",
    "dev": "node scripts/prepare-env.mjs && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/download-ollama.mjs && node scripts/patch-deepseek-reasoning.mjs && electron-builder install-app-deps",
    "download-model": "node scripts/download-model.mjs",
    "build:unpack": "node scripts/download-model.mjs && npm run build && electron-builder --dir",
    "build:win": "node scripts/download-model.mjs && npm run build && electron-builder --win",
    "build:mac": "node scripts/download-model.mjs && electron-vite build && electron-builder --mac",
    "build:linux": "node scripts/download-model.mjs && electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lancedb/lancedb": "^0.19.1",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.38",
    "@langchain/langgraph": "^1.2.6",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/openai": "^1.4.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "@xyflow/react": "^12.10.2",
    "@zilliz/milvus2-sdk-node": "^2.6.14",
    "ahooks": "^3.9.7",
    "axios": "^1.6.8",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "cronstrue": "^3.14.0",
    "dagre": "^0.8.5",
    "electron-updater": "^6.3.9",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "jschardet": "^3.1.4",
    "langchain": "^1.3.5",
    "markdown-it": "^14.1.1",
    "mongodb": "^7.2.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "ollama": "^0.6.3",
    "pg": "^8.20.0",
    "react-hook-form": "^7.72.1",
    "react-markdown-editor-lite": "^1.4.2",
    "react-router-dom": "^7.14.0",
    "react-simple-code-editor": "^0.14.1",
    "redis": "^5.12.1",
    "sequelize": "^6.37.8",
    "sqlite-vec": "^0.1.9",
    "sqlite3": "^6.0.1",
    "tedious": "^19.2.1",
    "uuid": "^13.0.0",
    "weaviate-ts-client": "^2.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sequelize": "^6.12.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "dotenv": "^16.4.5",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "less": "^4.6.4",
    "postcss": "^8.5.8",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "3.4.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
